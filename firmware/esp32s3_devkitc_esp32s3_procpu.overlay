/*
 * ESP32-S3-DevKitC-1 pin map (Lab 3, Task A). Port = this file; the C does not change.
 * Started from nucleo_l476rg.overlay; pins from firmware/superloop/README.md.
 *
 * Instrumentation: GPIO4,5,6,7,15,17 (header J1, consecutive with GPIO16).
 * Valve (led0): GPIO21. Flow input: GPIO16. Console: uart0 on the UART jack.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	/* The devkit has no plain LED: the valve gets its own gpio-leds node. */
	aliases {
		led0 = &valve_out;
	};

	leds {
		compatible = "gpio-leds";
		valve_out: valve_out { gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>; };
	};

	instr {
		compatible = "gpio-leds";
		instr_samp: instr_samp { gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; };
		instr_ctrl: instr_ctrl { gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };
		instr_cons: instr_cons { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		instr_tele: instr_tele { gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>; };
		instr_flow: instr_flow { gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; };
		instr_disp: instr_disp { gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>; };
	};

	keys {
		compatible = "gpio-keys";
		flow_pulse: flow_pulse {
			gpios = <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};
	};
};

/* Optional SSD1306 HMI (only with -DEXTRA_CONF_FILE=display.conf, not used today).
 * The S3 board leaves i2c0 off: SDA GPIO1 / SCL GPIO2. */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		segment-remap;
		com-invdir;
	};
};